# Copy to .env inside whatsapp/. Do not paste secrets into chat.
MODE=simulation
WHATSAPP_PROVIDER=meta
HOST=127.0.0.1
PORT=4190
DB_PATH=data/whatsapp.sqlite
PUBLIC_ORIGIN=http://127.0.0.1:4190
# Generate locally: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
ADMIN_TOKEN=
OPENAI_API_KEY=
# Choose a Responses + Structured Outputs compatible model after checking costs.
OPENAI_MODEL=
META_APP_SECRET=
META_VERIFY_TOKEN=
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
# Set a currently supported version; no automatic upgrade.
META_GRAPH_VERSION=
# Alternative: WHATSAPP_PROVIDER=ycloud for the approved Free partner.
YCLOUD_API_KEY=
YCLOUD_WEBHOOK_SECRET=
YCLOUD_PHONE_NUMBER=
YCLOUD_WABA_ID=
# Only after testing onboarding, manual events and costs for your account.
COEXISTENCE_VALIDATED=false
HISTORY_LIMIT=20
INPUT_LIMIT=4000
MESSAGE_DEBOUNCE_MS=3000
MESSAGE_BATCH_MAX_WAIT_MS=8000
CONTACT_DAILY_LIMIT=30
GLOBAL_DAILY_LIMIT=300
OUTBOUND_MONTHLY_LIMIT=900
MAX_OUTPUT_TOKENS=800
TIMEOUT_MS=30000
RETENTION_DAYS=30
